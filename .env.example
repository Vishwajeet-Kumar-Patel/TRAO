# Server & Environment
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# MongoDB Database URI (Auto-falls back to resilient in-memory store if unavailable)
MONGODB_URI=mongodb://localhost:27017/interview_prep_kit

# LLM Configuration (Google Gemini / OpenAI / Groq / OpenRouter)
# If no key is set, the system seamlessly uses deterministic NLP extraction for offline/evaluation reliability.
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
LLM_BASE_URL=

# Security & Crawler Configuration
ALLOW_LOCALHOST_SSRF=true
CRAWLER_MAX_PAGES=4
CRAWLER_TIMEOUT_MS=6000

# Frontend Next.js Public Config
NEXT_PUBLIC_API_URL=http://localhost:5000/api
