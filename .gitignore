# ============================================================
# PrepKit AI — Root .gitignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
dist/
build/
out/
**/.next/
**/dist/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript cache
*.tsbuildinfo
**/*.tsbuildinfo

# Test coverage reports
/coverage/
backend/coverage/
shared/coverage/
frontend/coverage/
*.lcov

# Misc
.turbo/
.vercel/
.netlify/
