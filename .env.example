# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render Web Service / Local Backend)
# ==============================================================================
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# External Database: MongoDB Atlas (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/prepkit?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_prep_kit?retryWrites=true&w=majority

# Allowed Frontend URLs for CORS (comma-separated list of allowed origins)
FRONTEND_URL=https://your-frontend.vercel.app

# LLM Provider Configuration (Google Gemini / OpenAI Compatible)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=

# Crawler & SSRF Protection
# Set to 'false' in production; 'true' in development or evaluation mode
ALLOW_LOCALHOST_SSRF=false
CRAWLER_MAX_PAGES=4
CRAWLER_TIMEOUT_MS=8000

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel Project / Local Next.js)
# ==============================================================================
# Public backend API URL exposed to browser bundle (no trailing slash or with /api)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
