{
  "name": "ai-interview-prep-kit",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Prep Kit with deterministic coverage, schedule allocation, crawler, and batch evaluation CLI",
  "scripts": {
    "evaluate": "tsx backend/src/scripts/evaluate.ts",
    "dev:backend": "npm run dev --workspace=@prep-kit/backend",
    "dev:frontend": "npm run dev --workspace=@prep-kit/frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:shared": "npm run build --workspace=@prep-kit/shared",
    "build:backend": "npm run build --workspace=@prep-kit/backend",
    "build:frontend": "npm run build --workspace=@prep-kit/frontend",
    "build:server": "npm run build:shared && npm run build:backend",
    "build": "npm run build:server && npm run build:frontend",
    "start:backend": "npm run start --workspace=@prep-kit/backend",
    "start:frontend": "npm run start --workspace=@prep-kit/frontend",
    "test": "npm run test --workspace=@prep-kit/backend",
    "test:shared": "npm run test --workspace=@prep-kit/shared"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
